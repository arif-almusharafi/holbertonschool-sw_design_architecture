classDiagram
    Library "1" o-- "0..*" Book
    Library "1" o-- "0..*" User
    Library "1" *-- "0..*" Loan
    Loan "0..*" --> "1" User
    Loan "0..*" --> "1" Book
    Book  : +str title
    Book  : +str author
    Book : +bool state
    Book : +mark_as_unavailable()
    Book : +mark_as_available()
    class User {
      +str name
      +str email
    }
    class Loan {
      +str start_date
      +str end_date
      +close_loan()
    }
    class Library {
      +add_book()
      +register_user()
      +create_loan()
    }
